<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" child.project.url.inherit.append.path="false" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Parent and aggregator of every module. All modules share this version and are released together. -->
    <groupId>io.descoped.lds</groupId>
    <artifactId>linked-data-store-project</artifactId>
    <version>3.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Linked Data Store Project</name>
    <description>Linked Data Store: a server that gives REST and GraphQL access to versioned, linked JSON documents
        described by a model read at start, with pluggable persistence (PostgreSQL, Neo4j, memory)
        and search (Solr).
    </description>
    <url>https://github.com/descoped/linked-data-store-project</url>
    <inceptionYear>2018</inceptionYear>

    <modules>
        <module>linked-data-store-bom</module>
        <module>linked-data-store-persistence-provider-api</module>
        <module>linked-data-store-persistence-provider-tck</module>
        <module>linked-data-store-persistence-provider-memory</module>
        <module>linked-data-store-persistence-provider-neo4j</module>
        <module>linked-data-store-persistence-provider-postgres</module>
        <module>linked-data-store-search-provider-api</module>
        <module>linked-data-store-search-provider-solr</module>
        <module>linked-data-store-core</module>
        <module>linked-data-store-server</module>
        <module>linked-data-store-loadtest</module>
    </modules>

    <properties>
        <java.version>27</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Reproducible builds: every jar entry gets this time, so the same tag builds the same bytes.
             release:prepare sets it to the release time. -->
        <project.build.outputTimestamp>2026-11-21T12:00:00Z</project.build.outputTimestamp>

        <!-- Dependency versions. Kept as properties, not in dependencyManagement, so that importing
             linked-data-store-bom (which inherits this POM) manages the Linked Data Store modules only. -->
        <slf4j.version>2.0.20</slf4j.version>
        <logback.version>1.6.8</logback.version>
        <jackson.version>3.3.0</jackson.version>
        <jackson-dataformat-msgpack.version>3.0.0</jackson-dataformat-msgpack.version>
        <hikaricp.version>7.1.0</hikaricp.version>
        <postgresql.version>42.7.14</postgresql.version>
        <neo4j-java-driver.version>6.3.0</neo4j-java-driver.version>
        <handy-uri-templates.version>2.1.8</handy-uri-templates.version>
        <commons-math3.version>3.6.1</commons-math3.version>
        <javax-inject.version>1</javax-inject.version>
        <junit.version>6.1.3</junit.version>
        <testng.version>7.12.0</testng.version>
        <assertj.version>3.27.7</assertj.version>
        <awaitility.version>4.3.0</awaitility.version>
        <jsonassert.version>1.5.3</jsonassert.version>
        <rawdata-client.version>3.0.1</rawdata-client.version>
        <java-tuple.version>0.1.0</java-tuple.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <rxjava.version>3.1.12</rxjava.version>
        <reactive-streams.version>1.0.4</reactive-streams.version>
        <cantara-saga.version>2.1.3</cantara-saga.version>
        <dynamic-configuration.version>3.0.1</dynamic-configuration.version>
        <graphql-java.version>26.2</graphql-java.version>
        <graphql-java-extended-scalars.version>24.0</graphql-java-extended-scalars.version>
        <undertow.version>2.4.4.Final</undertow.version>
        <xnio.version>3.8.17.Final</xnio.version>
        <jboss-threads.version>3.11.1</jboss-threads.version>
        <json-schema-validator.version>3.0.9</json-schema-validator.version>
        <tika.version>4.2.0</tika.version>
        <okhttp.version>5.5.1</okhttp.version>
        <solr.version>10.1.0</solr.version>
    </properties>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Ove Ranheim</name>
            <email>ove.ranheim@gmail.com</email>
            <url>https://www.linkedin.com/in/overanheim/</url>
        </developer>
    </developers>

    <contributors>
        <contributor>
            <name>Kim Christian Gaarder</name>
            <url>https://www.linkedin.com/in/kimchristiangaarder/</url>
        </contributor>
    </contributors>

    <!-- The modules live in this repository: their url and scm are the project's, not <url>/<artifactId>. -->
    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
        <connection>scm:git:git://github.com/descoped/linked-data-store-project.git</connection>
        <developerConnection>scm:git:git@github.com:descoped/linked-data-store-project.git</developerConnection>
        <url>https://github.com/descoped/linked-data-store-project/tree/master</url>
        <tag>HEAD</tag>
    </scm>

    <!-- The Cantara saga libraries (no.cantara.saga, future-selector) are not on Maven Central. This repository goes
         when core stops using them. -->
    <repositories>
        <repository>
            <id>cantara-releases</id>
            <name>Cantara Release Repository</name>
            <url>https://mvnrepo.cantara.no/content/repositories/releases/</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <profiles>
        <!-- Releases to Maven Central through the Central Portal, by central-publishing-maven-plugin. Only releases:
             SNAPSHOTs are not published.
             Release (Ove approves each one): ./mvnw release:prepare release:perform
             Server `central` in ~/.m2/settings.xml holds the Portal user token and, for Maven 3.10, lists
             https://central.sonatype.com in repositoryOrigins. Releases are uploaded with autoPublish=false and
             published by hand in the Portal. -->
        <profile>
            <id>central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                            <!-- The load test is a tool of this repository, not a library: it is built and
                                 checked with the reactor and stays out of a release. -->
                            <excludeArtifacts>
                                <artifact>linked-data-store-loadtest</artifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Signing, required by Central for releases. gpg's default-key signs. -->
        <profile>
            <id>sign</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>report</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          One SonarCloud project for the whole reactor. Coverage comes from the report of the coverage profile that
          joins every module (in linked-data-store-server), so a class is covered by the tests of any module that
          runs it, and from the module's own report for the modules outside it (the load test).
          The rules that do not fit this code are switched off where they do not fit, each with its reason:
          e1      java:S106, the load test statistics is a command-line program; its messages to the person running
                  it go to standard error, and the module has no logger.
          e2..e7  java:S1181, catching Throwable is how these keep their promise when an Error is thrown: a stream
                  still ends with onError, a future is still completed, a saga log is still released and the
                  recovery still goes on.
          e8..e10 java:S1168, in the GraphQL fetchers null is the GraphQL answer null; an empty map or list would
                  answer an object or [] instead.
          e11..e12 java:S4790, SHA-1 is the lookup key of a stored value, not a security use; another algorithm
                  would change stored data.
        -->
        <profile>
            <id>sonar</id>
            <properties>
                <sonar.host.url>https://sonarcloud.io</sonar.host.url>
                <sonar.organization>descoped</sonar.organization>
                <sonar.projectKey>descoped_linked-data-store-project</sonar.projectKey>
                <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/linked-data-store-server/target/site/jacoco-aggregate/jacoco.xml,${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
                <sonar.issue.ignore.multicriteria>e1,e2,e3,e4,e5,e6,e7,e8,e9,e10,e11,e12</sonar.issue.ignore.multicriteria>
                <sonar.issue.ignore.multicriteria.e1.ruleKey>java:S106</sonar.issue.ignore.multicriteria.e1.ruleKey>
                <sonar.issue.ignore.multicriteria.e1.resourceKey>**/io/descoped/lds/loadtest/**</sonar.issue.ignore.multicriteria.e1.resourceKey>
                <sonar.issue.ignore.multicriteria.e2.ruleKey>java:S1181</sonar.issue.ignore.multicriteria.e2.ruleKey>
                <sonar.issue.ignore.multicriteria.e2.resourceKey>**/AsyncIterablePublisher.java</sonar.issue.ignore.multicriteria.e2.resourceKey>
                <sonar.issue.ignore.multicriteria.e3.ruleKey>java:S1181</sonar.issue.ignore.multicriteria.e3.ruleKey>
                <sonar.issue.ignore.multicriteria.e3.resourceKey>**/ResultSetPublisher.java</sonar.issue.ignore.multicriteria.e3.resourceKey>
                <sonar.issue.ignore.multicriteria.e4.ruleKey>java:S1181</sonar.issue.ignore.multicriteria.e4.ruleKey>
                <sonar.issue.ignore.multicriteria.e4.resourceKey>**/Neo4jTransaction.java</sonar.issue.ignore.multicriteria.e4.resourceKey>
                <sonar.issue.ignore.multicriteria.e5.ruleKey>java:S1181</sonar.issue.ignore.multicriteria.e5.ruleKey>
                <sonar.issue.ignore.multicriteria.e5.resourceKey>**/SagaExecutionCoordinator.java</sonar.issue.ignore.multicriteria.e5.resourceKey>
                <sonar.issue.ignore.multicriteria.e6.ruleKey>java:S1181</sonar.issue.ignore.multicriteria.e6.ruleKey>
                <sonar.issue.ignore.multicriteria.e6.resourceKey>**/SagaRecoveryTrigger.java</sonar.issue.ignore.multicriteria.e6.resourceKey>
                <sonar.issue.ignore.multicriteria.e7.ruleKey>java:S1181</sonar.issue.ignore.multicriteria.e7.ruleKey>
                <sonar.issue.ignore.multicriteria.e7.resourceKey>**/SagasObserver.java</sonar.issue.ignore.multicriteria.e7.resourceKey>
                <sonar.issue.ignore.multicriteria.e8.ruleKey>java:S1168</sonar.issue.ignore.multicriteria.e8.ruleKey>
                <sonar.issue.ignore.multicriteria.e8.resourceKey>**/PersistenceFetcher.java</sonar.issue.ignore.multicriteria.e8.resourceKey>
                <sonar.issue.ignore.multicriteria.e9.ruleKey>java:S1168</sonar.issue.ignore.multicriteria.e9.ruleKey>
                <sonar.issue.ignore.multicriteria.e9.resourceKey>**/PersistenceLinkFetcher.java</sonar.issue.ignore.multicriteria.e9.resourceKey>
                <sonar.issue.ignore.multicriteria.e10.ruleKey>java:S1168</sonar.issue.ignore.multicriteria.e10.ruleKey>
                <sonar.issue.ignore.multicriteria.e10.resourceKey>**/PersistenceLinksFetcher.java</sonar.issue.ignore.multicriteria.e10.resourceKey>
                <sonar.issue.ignore.multicriteria.e11.ruleKey>java:S4790</sonar.issue.ignore.multicriteria.e11.ruleKey>
                <sonar.issue.ignore.multicriteria.e11.resourceKey>**/Fragment.java</sonar.issue.ignore.multicriteria.e11.resourceKey>
                <sonar.issue.ignore.multicriteria.e12.ruleKey>java:S4790</sonar.issue.ignore.multicriteria.e12.ruleKey>
                <sonar.issue.ignore.multicriteria.e12.resourceKey>**/Neo4jDocumentWriter.java</sonar.issue.ignore.multicriteria.e12.resourceKey>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonarsource.scanner.maven</groupId>
                        <artifactId>sonar-maven-plugin</artifactId>
                        <version>5.9.0.7382</version>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <!-- The rule is every lint warning on and fatal. A module that still carries pre-3.0 code overrides
                     compilerArgs with the categories it has not been cleaned of yet, and loses the override in the
                     pull request that revises it. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                            <arg>-Werror</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>

                <!-- The pre-3.0 tests sit in the same packages as the code and were written for the class path; they
                     run there until each module gets a test module of its own. Besides *Test, the classes named
                     *IntegrationTest run too: before 3.0 they were excluded and never ran. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.1</version>
                    <configuration>
                        <useModulePath>false</useModulePath>
                    </configuration>
                </plugin>

                <!-- Tests that need what the package phase makes (*IT); the server module runs them. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.6.1</version>
                    <configuration>
                        <useModulePath>false</useModulePath>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                    <configuration>
                        <doclint>all</doclint>
                        <failOnWarnings>true</failOnWarnings>
                        <!-- No links to the other modules' apidocs: they are not published anywhere, and javadoc
                             warns when a class-path module (the TCK) links to a named one. -->
                        <detectOfflineLinks>false</detectOfflineLinks>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.11.0</version>
                </plugin>

                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.16</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>3.3.1</version>
                    <configuration>
                        <tagNameFormat>@{project.version}</tagNameFormat>
                        <autoVersionSubmodules>true</autoVersionSubmodules>
                        <releaseProfiles>central,sign</releaseProfiles>
                        <goals>deploy</goals>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>${java.version}</version>
                                </requireJavaVersion>
                                <!-- Sonatype's central-publishing-maven-plugin does not support Maven 4. -->
                                <requireMavenVersion>
                                    <version>[3.6.3,4)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
