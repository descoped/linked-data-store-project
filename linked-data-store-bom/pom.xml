<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.descoped.lds</groupId>
        <artifactId>linked-data-store-project</artifactId>
        <version>3.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>linked-data-store-bom</artifactId>
    <packaging>pom</packaging>

    <name>Linked Data Store BOM</name>
    <description>Import this to align the versions of every Linked Data Store module.</description>

    <!-- Manages the Linked Data Store modules only: the parent keeps its dependency versions in properties, so
         nothing else is inherited into this dependencyManagement. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.descoped.lds</groupId>
                <artifactId>linked-data-store-persistence-provider-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.descoped.lds</groupId>
                <artifactId>linked-data-store-persistence-provider-tck</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.descoped.lds</groupId>
                <artifactId>linked-data-store-persistence-provider-memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.descoped.lds</groupId>
                <artifactId>linked-data-store-persistence-provider-neo4j</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.descoped.lds</groupId>
                <artifactId>linked-data-store-persistence-provider-postgres</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.descoped.lds</groupId>
                <artifactId>linked-data-store-index-queue-postgres</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.descoped.lds</groupId>
                <artifactId>linked-data-store-search-provider-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.descoped.lds</groupId>
                <artifactId>linked-data-store-search-provider-solr</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.descoped.lds</groupId>
                <artifactId>linked-data-store-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.descoped.lds</groupId>
                <artifactId>linked-data-store-server</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
