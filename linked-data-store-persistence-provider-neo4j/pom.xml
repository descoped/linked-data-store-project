<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.descoped.lds</groupId>
        <artifactId>linked-data-store-project</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>linked-data-store-persistence-provider-neo4j</artifactId>
    <packaging>jar</packaging>

    <name>Linked Data Store Persistence Provider Neo4j</name>
    <description>Persistence provider that stores documents as a graph in Neo4j.</description>

    <build>
        <plugins>
            <!-- Pre-3.0 code: these lint categories are not clean yet. Every other warning fails the build, and
                 this override goes when the module is revised. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs combine.self="override">
                        <arg>-Xlint:all,-requires-automatic,-unchecked,-deprecation</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!-- The TCK run needs a Neo4j server, and the provider's schema statements are Neo4j 4 syntax. It is switched on,
                 against a Neo4j container, when the provider is revised. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/Neo4jPersistenceIntegrationTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- Pre-3.0 code has little Javadoc. Doclint checks what is there; missing Javadoc becomes an
                 error again when the module is revised. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <doclint>all,-missing</doclint>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>io.descoped.lds</groupId>
            <artifactId>linked-data-store-persistence-provider-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.neo4j.driver</groupId>
            <artifactId>neo4j-java-driver</artifactId>
            <version>${neo4j-java-driver.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>jul-to-slf4j</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.descoped.lds</groupId>
            <artifactId>linked-data-store-persistence-provider-tck</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
