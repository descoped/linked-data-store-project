<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.descoped.lds</groupId>
        <artifactId>linked-data-store-project</artifactId>
        <version>3.0.1</version>
    </parent>

    <artifactId>linked-data-store-server</artifactId>
    <packaging>jar</packaging>

    <name>Linked Data Store Server</name>
    <description>The runnable Linked Data Store: core with every persistence and search provider, the main class and the container image.</description>

    <properties>
        <!-- What the tests of the image read besides src: the build cache counts a change of them as a change of
             the module, so the image is tested again. -->
        <maven.build.cache.input.1>Dockerfile</maven.build.cache.input.1>
        <maven.build.cache.input.2>.dockerignore</maven.build.cache.input.2>
        <maven.build.cache.input.3>compose.yaml</maven.build.cache.input.3>
        <maven.build.cache.input.4>postgres-init.sql</maven.build.cache.input.4>
        <maven.build.cache.input.5>schemas</maven.build.cache.input.5>
    </properties>

    <build>
        <plugins>
            <!-- The image is made of every jar in target and target/lib. The jars of an earlier build go first,
                 so that a library or a version that has changed since is not there twice. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>remove-the-jars-of-an-earlier-build</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>*.jar</include>
                                        <include>lib/**</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Everything LDS runs with, next to its own jar: what the container image is made of. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-runtime-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The tests of the image (*IT) run after the jars are made: they build the image from the
                 Dockerfile and start it. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>io.descoped.config</groupId>
            <artifactId>dynamic-configuration</artifactId>
            <version>${dynamic-configuration.version}</version>
        </dependency>
        <dependency>
            <groupId>io.descoped.lds</groupId>
            <artifactId>linked-data-store-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.reactivex.rxjava3</groupId>
            <artifactId>rxjava</artifactId>
            <version>${rxjava.version}</version>
        </dependency>
        <dependency>
            <groupId>no.cantara.saga</groupId>
            <artifactId>sagalog-postgres</artifactId>
            <version>${cantara-saga.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.descoped.rawdata</groupId>
            <artifactId>rawdata-client-api</artifactId>
            <version>${rawdata-client.version}</version>
        </dependency>
        <dependency>
            <groupId>io.descoped.rawdata</groupId>
            <artifactId>rawdata-client-provider-postgres</artifactId>
            <version>${rawdata-client.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.descoped.lds</groupId>
            <artifactId>linked-data-store-persistence-provider-neo4j</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.descoped.lds</groupId>
            <artifactId>linked-data-store-persistence-provider-postgres</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.descoped.lds</groupId>
            <artifactId>linked-data-store-index-queue-postgres</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.descoped.lds</groupId>
            <artifactId>linked-data-store-persistence-provider-memory</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.descoped.lds</groupId>
            <artifactId>linked-data-store-search-provider-solr</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>jcl-over-slf4j</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>${awaitility.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- One coverage report of every module the server is made of, from the tests of all of them: a class is
             covered by the tests of any module that runs it (the shared suite runs the persistence API in each
             provider). SonarCloud reads it (sonar.coverage.jacoco.xmlReportPaths in the root POM). -->
        <profile>
            <id>coverage</id>
            <!-- report-aggregate takes only the modules named here. The two API modules come in through core, so
                 they are named again, with the scope they have through core: the jars are the same as without
                 the profile. A module the server gets only through another one is named here too, or its
                 coverage drops out of the report. -->
            <dependencies>
                <dependency>
                    <groupId>io.descoped.lds</groupId>
                    <artifactId>linked-data-store-persistence-provider-api</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>io.descoped.lds</groupId>
                    <artifactId>linked-data-store-search-provider-api</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>report-aggregate</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report-aggregate</goal>
                                </goals>
                                <configuration>
                                    <dataFileIncludes>
                                        <dataFileInclude>target/jacoco/*.exec</dataFileInclude>
                                    </dataFileIncludes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
